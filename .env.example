# Configurações do Synapse
# Copie este arquivo para .env e preencha sua chave do Gemini (opcional — possui modo fallback local)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Banco de dados SQLite local
DATABASE_PATH=synapse.db

# Fuso horário padrão (RN03)
TIMEZONE=America/Fortaleza

# Integração opcional com Google Calendar API (OAuth token ou modo local/pendente)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Integração opcional de Notificações via Webhook (ex.: Discord, Slack, n8n, Blip)
NOTIFICATION_WEBHOOK_URL=
